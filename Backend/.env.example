# Copier en « .env » et adapter. Ne jamais committer le vrai .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-secret-a-remplacer-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (PostgreSQL, dev comme prod) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=siptrack
DB_USER=postgres
DB_PASSWORD=a-remplacer

# Alternative : fournir directement l'URL complète, qui prend le pas sur les DB_* ci-dessus.
# DATABASE_URL=postgres://user:password@localhost:5432/siptrack
