# Modèle pour l'outillage local (docker-compose.yml).
# Copier en .env.docker et remplacer les valeurs. .env.docker est ignoré par git.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d

# --- Base de données locale ---
DB_NAME=siptrack
DB_USER=siptrack
DB_PASSWORD=change-moi

# --- pgAdmin (http://127.0.0.1:5050) ---
PGADMIN_EMAIL=admin@siptrack.local
PGADMIN_PASSWORD=change-moi

# Portainer (https://127.0.0.1:9443) ne se configure pas ici : il demande de
# créer le compte administrateur à la première connexion.
